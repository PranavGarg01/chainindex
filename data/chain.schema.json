{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainindex.dev/schema/chain.v2.json",
  "title": "ChainIndex chain record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "slug",
    "chainId",
    "networkType",
    "status",
    "nativeCurrency",
    "rpc",
    "explorers"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "chainId": { "type": "integer", "minimum": 1 },
    "networkType": { "enum": ["mainnet", "testnet", "devnet", "local"] },
    "status": { "enum": ["active", "deprecated", "unverified", "coming_soon"] },
    "nativeCurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "decimals"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "decimals": { "type": "integer", "minimum": 0 }
      }
    },
    "rpc": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["isRecommended"],
        "properties": { "isRecommended": { "const": true } }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "isRecommended"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "isRecommended": { "type": "boolean" }
        }
      }
    },
    "explorers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "website": { "type": "string", "format": "uri", "pattern": "^https://" },
    "docs": { "type": "string", "format": "uri", "pattern": "^https://" },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
